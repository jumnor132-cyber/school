# ==============================================================================
# Frontend Environment Configuration Template
# ==============================================================================
# In React (Create React App), all custom variables MUST start with REACT_APP_
# After editing, you must restart your React development server (npm start).
# ==============================================================================

# Option 1: Localhost Backend (PHP server running on http://localhost:8000)
REACT_APP_API_URL=http://localhost:8000

# Option 2: Live Production Server (Render)
# REACT_APP_API_URL=https://student-backend-1gcn.onrender.com

# Optional development server port
PORT=3000
